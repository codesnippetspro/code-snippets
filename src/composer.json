{
    "name": "codesnippetspro/code-snippets-pro",
    "description": "Manage code snippets running on a WordPress-powered site through a graphical interface",
    "keywords": [
        "wordpress",
        "snippets",
        "organization"
    ],
    "type": "wordpress-plugin",
    "homepage": "https://wordpress.org/plugins/code-snippets",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Shea Bunge",
            "email": "shea@codesnippets.pro",
            "homepage": "https://sheabunge.com"
        }
    ],
    "support": {
        "issues": "https://github.com/codesnippetspro/code-snippets/issues",
        "source": "https://github.com/codesnippetspro/code-snippets"
    },
    "autoload": {
        "classmap": [
            "php/"
        ]
    },
    "require": {
        "php": ">=7.4",
        "ext-dom": "*",
        "ext-json": "*",
        "composer/installers": "^2.3",
        "freemius/wordpress-sdk": "^2.11",
        "guzzlehttp/guzzle": "^7.9",
        "matthiasmullie/minify": "^1.3",
        "symfony/deprecation-contracts": "^2.5",
        "typisttech/imposter-plugin": "^0.6.2"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wp-cli-stubs": "^2.11",
        "php-stubs/wordpress-stubs": "^6.7"
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true,
            "typisttech/imposter-plugin": true
        }
    },
    "extra": {
        "imposter": {
            "namespace": "Code_Snippets\\Vendor"
        }
    },
    "scripts": {
        "post-install-cmd": "node ../node_modules/ts-node/dist/bin.js ../scripts/composer-fix-autoload.ts",
        "post-update-cmd": "node ../node_modules/ts-node/dist/bin.js ../scripts/composer-fix-autoload.ts"
    }
}
