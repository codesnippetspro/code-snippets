{
    "name": "codesnippetspro/code-snippets-pro",
    "description": "Manage code snippets running on a WordPress-powered site through a graphical interface",
    "keywords": [
        "wordpress",
        "snippets",
        "organization"
    ],
    "type": "wordpress-plugin",
    "homepage": "https://wordpress.org/plugins/code-snippets",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Shea Bunge",
            "email": "shea@codesnippets.pro",
            "homepage": "https://sheabunge.com"
        }
    ],
    "support": {
        "issues": "https://github.com/codesnippetspro/code-snippets/issues",
        "source": "https://github.com/codesnippetspro/code-snippets"
    },
    "autoload": {
        "classmap": [
            "php/"
        ]
    },
    "require": {
        "composer/installers": "~1.12",
        "php": ">=7.4",
        "ext-dom": "*",
        "ext-json": "*",
        "matthiasmullie/minify": "^1.3",
        "freemius/wordpress-sdk": "^2.5.10",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/deprecation-contracts": "2.5"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1.0",
        "phpcompatibility/phpcompatibility-wp": "2.1.5",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
        "php-stubs/wp-cli-stubs": "^2.9",
        "php-stubs/wordpress-stubs": "^6.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true
        }
    }
}
